# Verwaltet von Ansible (Terrassenplaner)
[Unit]
Description=Terrassenplaner – Sicherung
{% if planer_betriebsart == 'container' %}
After=docker.service
{% else %}
After=grafana-server.service {{ sicherung_objectbox | map(attribute='dienst') | map('regex_replace', '$', '.service') | join(' ') }}
{% endif %}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/planer-sicherung
Nice=10
IOSchedulingClass=idle
