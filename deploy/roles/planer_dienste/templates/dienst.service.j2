# Verwaltet von Ansible (Terrassenplaner)
[Unit]
Description={{ item.beschreibung }}
After=network-online.target {{ item.nach | join(' ') }}
Wants=network-online.target {{ item.nach | join(' ') }}

[Service]
User={{ item.benutzer }}
EnvironmentFile=/etc/terrassenplaner/{{ item.name }}.env
# Native connectanum-Bibliotheken liegen im Bündel unter lib/.
Environment=LD_LIBRARY_PATH={{ planer_basis }}/{{ item.programm }}/lib
WorkingDirectory={{ planer_daten }}/{{ item.name }}
ExecStart={{ planer_basis }}/{{ item.programm }}/bin/{{ item.programm }}
Restart=on-failure
RestartSec=3
# Eigenes /tmp je Dienst (Härtung).
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ planer_daten }}/{{ item.name }}
# Weitere Härtung (M10-03): keine Rechte, kein Zugriff auf Kernel und Geräte;
# neue Dateien (Datenbank, Sicherung) nur für den Dienstbenutzer lesbar.
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
# Viele gleichzeitige WebSocket-Verbindungen (Router).
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
