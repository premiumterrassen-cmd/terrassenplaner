# Verwaltet von Ansible (Terrassenplaner)
[Unit]
Description={{ item.beschreibung }}
After=network-online.target {{ item.nach | join(' ') }}
Wants=network-online.target {{ item.nach | join(' ') }}

[Service]
User={{ item.benutzer }}
EnvironmentFile=/etc/terrassenplaner/{{ item.name }}.env
WorkingDirectory={{ planer_daten }}/{{ item.name }}
ExecStart={{ planer_basis }}/{{ item.programm }}/bin/{{ item.programm }}
Restart=on-failure
RestartSec=3
# Eigenes /tmp je Dienst: connectanum erlaubt eine Transportschicht je TMPDIR.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ planer_daten }}/{{ item.name }}

[Install]
WantedBy=multi-user.target
