# Verwaltet von Ansible (Terrassenplaner) – Container-Betrieb
global:
  scrape_interval: 15s
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
  - job_name: server
    static_configs:
      - targets: ["node-exporter:9100"]
  - job_name: wamp
    static_configs:
      - targets: ["router:8081"]
        labels: {dienst: planer-router}
      - targets: ["auth:8083"]
        labels: {dienst: planer-auth}
  - job_name: datenbank
    static_configs:
      - targets: ["auth:8084"]
        labels: {dienst: planer-auth}
  - job_name: traefik
    static_configs:
      - targets: ["traefik:8080"]
