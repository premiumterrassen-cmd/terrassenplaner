# Verwaltet von Ansible (Terrassenplaner)
global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ monitoring_prometheus_listen }}"]
  - job_name: server
    static_configs:
      - targets: ["127.0.0.1:9100"]
  - job_name: wamp
    # Alle WAMP-Dienste (Router, Auth-Server) – weitere hier ergänzen.
    static_configs:
      - targets: ["{{ planer_router_health }}"]
        labels: {dienst: planer-router}
      - targets: ["{{ planer_auth_health }}"]
        labels: {dienst: planer-auth}
  - job_name: datenbank
    static_configs:
      - targets: ["{{ planer_datenbank_metriken }}"]
        labels: {dienst: planer-auth}
  - job_name: traefik
    static_configs:
      - targets: ["127.0.0.1:8092"]
