; Verwaltet von Ansible (Terrassenplaner) – enthält das Admin-Passwort
[server]
http_addr = 127.0.0.1
http_port = {{ monitoring_grafana_port }}
domain = {{ monitoring_domain }}
root_url = https://{{ monitoring_domain }}/

[security]
admin_user = {{ planer_grafana_admin }}
admin_password = {{ planer_grafana_admin_passwort }}
cookie_secure = true
disable_gravatar = true

[auth.anonymous]
enabled = false

[users]
allow_sign_up = false

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[news]
news_feed_enabled = false

; Eigene Metriken von Grafana nicht über die öffentliche Domain ausliefern.
[metrics]
enabled = false

[smtp]
enabled = {{ 'true' if planer_smtp_benutzer | default('') | length > 0 else 'false' }}
host = {{ planer_smtp_server | default('') }}
user = {{ planer_smtp_benutzer | default('') }}
password = """{{ planer_smtp_passwort | default('') }}"""
from_address = {{ planer_smtp_absender | default('') }}
from_name = Terrassenplaner Monitoring

[unified_alerting]
enabled = true
